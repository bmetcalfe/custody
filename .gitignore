# Python caches
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.nbc
*.nbi

# Virtualenvs and environment
.venv/
venv/
.env*
!.env.example

# Editor / OS
.DS_Store
.claude/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Build / packaging
*.egg-info/
dist/
build/
.coverage
htmlcov/

# Archives / scratch outputs
*.zip
*.log
pyproject.toml.save

# Large raw data — Umbra mirror lives outside git (~56 GB)
data/raw/

# Intermediate Parquet + COG outputs (regeneratable from raw/)
data/processed/

# Model checkpoints (fetched from upstream sources, not source-tracked)
data/models/

# Day-0 scratch workspace — rerun outputs, ad-hoc probes
day0/scratch/*
!day0/scratch/.gitkeep

# Live Sentinel ingestion output (regenerable). The committed
# *.fixture.json files are the demo source of truth.
data/demo/whitsun_sentinel_observations.json

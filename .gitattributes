# Normalize line endings in the repo to LF.
# Windows working trees may have CRLF locally; git stores LF.
* text=auto eol=lf

# Explicit LF for text sources
*.py    text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.js    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf

# Binary files — never normalize
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.tif     binary
*.tiff    binary
*.nitf    binary
*.parquet binary
*.joblib  binary
*.npy     binary
*.zip     binary
*.gz      binary
*.7z      binary
